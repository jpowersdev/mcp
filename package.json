{
  "name": "@jpowersdev/mcp",
  "version": "1.2.0",
  "type": "module",
  "packageManager": "pnpm@10.6.3+sha512.bb45e34d50a9a76e858a95837301bfb6bd6d35aea2c5d52094fa497a467c43f5c440103ce2511e9e0a2f89c3d6071baac3358fc68ac6fb75e2ceb3d2736065e6",
  "license": "MIT",
  "description": "MCP servers exposed as a CLI",
  "bin": {
    "mcp": "./dist/bin.cjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jpowersdev/mcp"
  },
  "publishConfig": {
    "access": "public",
    "directory": "dist"
  },
  "scripts": {
    "build": "tsup && pnpm copy-package-json",
    "build:ts": "tsup",
    "clean": "rimraf dist/*",
    "check": "tsc -b tsconfig.json",
    "lint": "eslint \"**/{src,test,examples,scripts,dtslint}/**/*.{ts,mjs}\"",
    "lint-fix": "pnpm lint --fix",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "copy-package-json": "tsx scripts/copy-package-json.ts",
    "version": "changeset version",
    "changeset-publish": "pnpm build && TEST_DIST= pnpm vitest && changeset publish"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.5.1",
    "@changesets/cli": "^2.28.1",
    "@effect/cli": "^0.58.3",
    "@effect/eslint-plugin": "^0.3.0",
    "@effect/language-service": "^0.4.0",
    "@effect/platform": "^0.79.3",
    "@effect/platform-node": "^0.75.3",
    "@effect/vitest": "^0.19.10",
    "@eslint/compat": "1.2.7",
    "@eslint/eslintrc": "3.3.0",
    "@eslint/js": "9.22.0",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.13.10",
    "@typescript-eslint/eslint-plugin": "^8.26.1",
    "@typescript-eslint/parser": "^8.26.1",
    "effect": "^3.13.12",
    "eslint": "^9.22.0",
    "eslint-import-resolver-typescript": "^4.2.1",
    "eslint-plugin-codegen": "0.30.0",
    "eslint-plugin-deprecation": "^3.0.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-sort-destructure-keys": "^2.0.0",
    "tsup": "^8.4.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.9"
  },
  "pnpm": {
    "patchedDependencies": {
      "@changesets/get-github-info@0.6.0": "patches/@changesets__get-github-info@0.6.0.patch"
    }
  },
  "dependencies": {
    "@effect/experimental": "^0.43.3",
    "@modelcontextprotocol/sdk": "^1.7.0",
    "@mozilla/readability": "^0.6.0",
    "jsdom": "^26.0.0",
    "neo4j-driver": "^5.28.1",
    "robots-parser": "^3.0.1",
    "rxjs": "^7.8.2"
  }
}
